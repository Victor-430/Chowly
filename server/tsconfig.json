{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es6",
    "moduleResolution": "node",
    // "ignoreDeprecations": "6.0",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./**/*", "prisma", "controllers", "middleware", "routes", "index.ts", "lib", "docs", "utils", "services", "validators", "script"]
}

